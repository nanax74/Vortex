<Page
    x:Class="Vortex.Views.StreamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Vortex.Views"
    xmlns:controls="using:Vortex.Controls">

    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="12">
        <!-- 入力エリア -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <controls:HexTextBox Bytes="{Binding DataBuffer, Mode=TwoWay}"
                                 Grid.Column="0"
                                 HorizontalAlignment="Stretch"
                                 Width="Auto"
                                 MinWidth="200"/>
            <Button Command="{Binding SendDataCommand}"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="4"
                    ToolTipService.ToolTip="Send">
                <FontIcon Glyph="&#xE724;"/>
            </Button>
        </Grid>

        <!-- ログ表示 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Sent" FontWeight="SemiBold"/>
                    <Button Command="{Binding ClearSentCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            ToolTipService.ToolTip="Clear">
                        <FontIcon Glyph="&#xE894;"/>
                    </Button>
                </StackPanel>
                <ListView ItemsSource="{Binding DataSent}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="Received" FontWeight="SemiBold"/>
                    <Button Command="{Binding ClearReceivedCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="4"
                            ToolTipService.ToolTip="Clear">
                        <FontIcon Glyph="&#xE894;"/>
                    </Button>
                </StackPanel>
                <ListView ItemsSource="{Binding DataReceived}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
