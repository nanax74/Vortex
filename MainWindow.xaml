<Window x:Class="Vortex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vortex"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Vortex" Height="540" Width="960">
    <Window.Resources>
        <local:HexConverter x:Key="HexConverter"/>
        <!-- ボタンのデフォルトスタイル -->
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Viewbox>
        <Grid Height="540" Width="960">
            <TabControl>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                        <Setter Property="Height" Value="60"/>
                    </Style>
                </TabControl.ItemContainerStyle>
                <!-- コネクトタブ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Wifi" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Connection" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox
                            Name="ServerIpTextBox"
                            FontSize="48"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Margin="5"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="IP Address"
                            Text="192.168.68.115"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBox
                            Name="PortTextBox"
                            FontSize="48"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Margin="5"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="Port"
                            Text="10000"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ConnectButton"
                            Grid.Column="0"
                            Click="ConnectButton_Click"
                            Margin="10"
                            Height="100"
                            Background="Green"
                            Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LanConnect"
                                 Width="75" Height="75"
                                 Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Connect" Margin="5" VerticalAlignment="Center" FontSize="48"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DisconnectButton"
                            Grid.Column="1"
                            Click="DisconnectButton_Click"
                            Margin="10"
                            Height="100"
                            Background="Gray"
                            Foreground="White"
                            IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LanDisconnect"
                                 Width="75" Height="75"
                                 Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Disconnect" Margin="5" VerticalAlignment="Center" FontSize="48"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- コマンドタブ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Terminal" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Command" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox
                                Name="CommandTextBox"
                                FontSize="32"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                Margin="5"
                                VerticalAlignment="Center"
                                materialDesign:HintAssist.Hint="Command"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Button x:Name="CommandSendButton" Content="Send" Grid.Row="0" Click="CommandSendButton_Click" Margin="5" FontSize="32" Height="80"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBox
                            x:Name="ProgressTextBox"
                            FontSize="32" IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="5"
                            Padding="10,0"
                            materialDesign:HintAssist.Hint="Progress"
                            UseLayoutRounding="True" HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            materialDesign:HintAssist.IsFloating="False"/>
                        </Grid>
                        <Grid Grid.Row="3">
                            <TextBox
                            x:Name="ResponseTextBox"
                            FontSize="32"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="5"
                            Padding="10,10"
                            materialDesign:HintAssist.Hint="Response"
                            UseLayoutRounding="True"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Top"
                            materialDesign:HintAssist.IsFloating="False"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- メモリータブ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Memory" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Memory" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBox Name="AddressTextBox"
                            Width="300"
                            FontSize="30"
                            Padding="0"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            materialDesign:HintAssist.Hint="Start Address"
                            Margin="10"/>
                        </StackPanel>
                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="5">
                            <DataGrid
                            x:Name="MemoryDataGrid"
                            FontSize="16"
                            AutoGenerateColumns="False"
                            Background="White"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            CanUserResizeColumns="False"
                            CanUserReorderColumns="False"
                            ItemsSource="{Binding MemoryEntries}"
                            GridLinesVisibility="All"
                            RowHeight="36"
                            HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address, StringFormat={}{0:X8}}" IsReadOnly="True" Width="*" />
                                    <DataGridTemplateColumn Header="Value" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:X8}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource HexConverter}}"
                                                PreviewTextInput="HexOnly_PreviewTextInput"
                                                CharacterCasing="Upper"
                                                Padding="0"
                                                MaxLength="8"
                                                FontFamily="Consolas"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                            <CheckBox Name="AutoUpdateCheckBox"
                            Content="Auto Update"
                            FontSize="20"
                            Padding="4,0,0,0"
                            Checked="AutoUpdateCheckBox_Checked"
                            Unchecked="AutoUpdateCheckBox_Unchecked"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <!-- ディスアセンブラタブ -->
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Code" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Disassembler" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBox Name="DisasmAddressTextBox"
                                Width="300"
                                FontSize="30"
                                Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                materialDesign:HintAssist.Hint="Start Address"
                                Margin="10"/>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="5">
                            <DataGrid x:Name="DisasmDataGrid"
                                FontSize="12"
                                AutoGenerateColumns="False"
                                Background="White"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                CanUserResizeColumns="False"
                                CanUserReorderColumns="False"
                                ItemsSource="{Binding MemoryEntries}"
                                GridLinesVisibility="All"
                                RowHeight="32"
                                HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address, StringFormat={}{0:X8}}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Bytes}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Instruction" Binding="{Binding Mnemonic}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Operands" Binding="{Binding Operands}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Viewbox>
</Window>
