<Window x:Class="Vortex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vortex"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Vortex" Height="540" Width="960">
    <Window.Resources>
        <!-- ボタンのデフォルトスタイル -->
        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatMidBgButton}">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Viewbox>
        <Grid Height="540" Width="960">
            <TabControl Name="MainTab" TabStripPlacement="Left">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                        <Setter Property="Height" Value="60"/>
                    </Style>
                </TabControl.ItemContainerStyle>
                <!-- コネクトタブ -->
                <TabItem Name="ConnectTab" HorizontalAlignment="Left" Padding="10">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="200">
                            <materialDesign:PackIcon Kind="Wifi" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Connection" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox
                            Name="ServerIpTextBox"
                            FontSize="48"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Margin="5"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="IP Address"
                            Text="192.168.68.115"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <TextBox
                            Name="PortTextBox"
                            FontSize="48"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Margin="5"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="Port"
                            Text="10000"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="ConnectButton"
                            Grid.Column="0"
                            Click="ConnectButton_Click"
                            Margin="10"
                            Height="100"
                            Background="Green"
                            Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LanConnect"
                                 Width="60" Height="60"
                                 Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Connect" Margin="5" VerticalAlignment="Center" FontSize="40"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DisconnectButton"
                            Grid.Column="1"
                            Click="DisconnectButton_Click"
                            Margin="10"
                            Height="100"
                            Background="Gray"
                            Foreground="White"
                            IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="LanDisconnect"
                                 Width="60" Height="60"
                                 Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Text="Disconnect" Margin="5" VerticalAlignment="Center" FontSize="40"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- コマンドタブ -->
                <TabItem Name="CommandTab" HorizontalAlignment="Left" Padding="10">
                    <TabItem.Header>
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Width="200">
                            <materialDesign:PackIcon Kind="Terminal" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Command" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBox
                            Name="CommandTextBox"
                            FontSize="32"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            Margin="5"
                            VerticalAlignment="Center"
                            materialDesign:HintAssist.Hint="Command"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Button x:Name="CommandSendButton" Content="Send" Grid.Row="0" Click="CommandSendButton_Click" Margin="5" FontSize="32" Height="80"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBox
                            x:Name="ProgressTextBox"
                            FontSize="32" IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="5"
                            Padding="10,0"
                            materialDesign:HintAssist.Hint="Progress"
                            UseLayoutRounding="True" HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Center"
                            materialDesign:HintAssist.IsFloating="False"/>
                        </Grid>
                        <Grid Grid.Row="3">
                            <TextBox
                            x:Name="ResponseTextBox"
                            FontSize="32"
                            IsReadOnly="True"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                            Margin="5"
                            Padding="10,10"
                            materialDesign:HintAssist.Hint="Response"
                            UseLayoutRounding="True"
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Top"
                            materialDesign:HintAssist.IsFloating="False"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <!-- メモリータブ -->
                <TabItem Name="MemoryTab" HorizontalAlignment="Left" Padding="10">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="200">
                            <materialDesign:PackIcon Kind="Memory" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Memory" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:HexadecimalTextBox
                            x:Name="MemoryStartAddressTextBox"
                            MaxLength="8"
                            Width="300"
                            FontSize="30"
                            Padding="0"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            materialDesign:HintAssist.Hint="Start Address"
                            Margin="10"
                            TextChanged="MemoryStartAddressTextBox_TextChanged"/>
                            <CheckBox Name="AutoUpdateCheckBox"
                            Content="Auto Update"
                            FontSize="20"
                            Padding="4,0,0,0"
                            Checked="AutoUpdateCheckBox_Checked"
                            Unchecked="AutoUpdateCheckBox_Unchecked"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </StackPanel>
                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DataGrid
                                x:Name="MemoryDataGrid"
                                FontSize="14"
                                AutoGenerateColumns="True"
                                Background="White"
                                ColumnWidth="*"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                CanUserResizeColumns="False"
                                CanUserReorderColumns="False"
                                GridLinesVisibility="All"
                                HeadersVisibility="Column"
                                SelectionMode="Single"
                                SelectionUnit="Cell"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center"
                                MouseDoubleClick="MemoryDataGrid_MouseDoubleClick">
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0"/>
                                            <Setter Property="TextBlock.FontSize" Value="16"/>
                                            <Setter Property="TextBlock.Height" Value="32"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                </DataGrid>
                                <ScrollBar x:Name="MemoryScrollBar"
                                Grid.Column="1"
                                Orientation="Vertical"
                                Minimum="0"
                                Maximum="4294967295"
                                SmallChange="16"
                                LargeChange="256"
                                ValueChanged="MemoryScrollBar_ValueChanged"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ディスアセンブラタブ -->
                <TabItem Name="DisassemblerTab" HorizontalAlignment="Left" Padding="10">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="200">
                            <materialDesign:PackIcon Kind="Code" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Disassembler" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ListBox Width="100" d:ItemsSource="{d:SampleData ItemCount=5}"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <local:HexadecimalTextBox
                            x:Name="DisasmStartAddressTextBox"
                            MaxLength="8"
                            Width="300"
                            FontSize="30"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            materialDesign:HintAssist.Hint="Start Address"
                            Margin="10"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBox
                            Name="DisasmTargetAddressTextBox"
                            Width="300"
                            FontSize="30"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            materialDesign:HintAssist.Hint="Target Address"
                            Margin="10"/>
                            <TextBox
                            Name="DisasmInstructionTextBox"
                            Width="300"
                            FontSize="30"
                            Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                            materialDesign:HintAssist.Hint="Instruction"
                            Margin="10"/>
                            <Button
                            Name="DisasmInstructionAssembleButton"
                            Width="50"
                            Height="50"
                            Style="{StaticResource MaterialDesignFloatingActionButton}"
                            ToolTip="Assemble">
                                <materialDesign:PackIcon Kind="Check" Width="30" Height="30" Foreground="White"/>
                            </Button>
                        </StackPanel>
                        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Padding="5">
                            <DataGrid x:Name="DisasmDataGrid"
                            FontSize="16"
                            AutoGenerateColumns="True"
                            Background="White"
                            ColumnWidth="*"
                            IsReadOnly="True"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            CanUserResizeColumns="False"
                            CanUserReorderColumns="False"
                            GridLinesVisibility="All"
                            RowHeight="36"
                            HeadersVisibility="Column"/>
                        </Border>
                    </Grid>
                </TabItem>
                <!-- ブレークポイントタブ -->
                <TabItem Name="BreakpointTab" HorizontalAlignment="Left" Padding="10">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="200">
                            <materialDesign:PackIcon Kind="Record" Width="36" Height="36" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Breakpoint" FontSize="24" Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                        <!-- Address Input -->
                        <local:HexadecimalTextBox
                        x:Name="DataBreakpointAddressTextBox"
                        Width="180"
                        FontSize="20"
                        MaxLength="8"
                        Padding="4"
                        Margin="4"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        materialDesign:HintAssist.Hint="Address"/>

                        <!-- Size ComboBox -->
                        <ComboBox
                        x:Name="SizeComboBox"
                        Width="130"
                        FontSize="20"
                        Padding="4"
                        Margin="4"
                        Style="{StaticResource MaterialDesignComboBox}"
                        materialDesign:HintAssist.Hint="Size (bytes)">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="8"/>
                        </ComboBox>

                        <!-- Read -->
                        <CheckBox
                        x:Name="ReadFlagCheckBox"
                        Content="Read"
                        VerticalAlignment="Center"
                        Margin="10,0"
                        Style="{StaticResource MaterialDesignCheckBox}">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>

                        <!-- Write -->
                        <CheckBox
                        x:Name="WriteFlagCheckBox"
                        Content="Write"
                        VerticalAlignment="Center"
                        Margin="10,0"
                        Style="{StaticResource MaterialDesignCheckBox}">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>

                        <!-- Set Button -->
                        <Button
                        Name="SetDataBreakpointButton"
                        Width="50"
                        Height="50"
                        Margin="10,0"
                        Style="{StaticResource MaterialDesignFloatingActionButton}"
                        ToolTip="Set">
                            <materialDesign:PackIcon Kind="Check" Width="30" Height="30" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Viewbox>
</Window>
