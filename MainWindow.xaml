<Window x:Class="Vortex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vortex"
        mc:Ignorable="d"
        Title="Vortex" Height="450" Width="800">
    <Viewbox>
        <Grid  Height="400" Width="600">
            <TabControl>
                <TabItem Header="Connect" FontSize="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- Server IP and Port inputs -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="Server IP:" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="36" Margin="10"/>
                            <TextBox x:Name="ServerIpTextBox" Grid.Column="1" Text="192.168.68.115" FontSize="36" Margin="10" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Label Content="Port:" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="36" Margin="10"/>
                            <TextBox x:Name="PortTextBox" Grid.Column="1" Text="10000" FontSize="36" Margin="10" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Buttons -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="Connect" Grid.Column="0" Click="ConnectButton_Click" VerticalAlignment="Center" Margin="10" FontSize="36"/>
                            <Button Content="Disconnect" Grid.Column="1" Click="DisconnectButton_Click" FontSize="36" VerticalAlignment="Center" Margin="10"/>
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Command" FontSize="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="3*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Command:" Grid.Column="0" VerticalAlignment="Center" Margin="10" FontSize="24"/>
                            <TextBox x:Name="CommandTextBox" Grid.Row="0" Margin="10" Grid.Column="1" FontSize="36"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Button Content="Send" Grid.Row="0" Click="SendButton_Click" Margin="10"/>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Label Content="Response:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="10"/>
                            <TextBox x:Name="ResponseTextBox" Grid.Row="2" Grid.Column="0" IsReadOnly="True" TextWrapping="Wrap" Margin="10"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Viewbox>
</Window>
