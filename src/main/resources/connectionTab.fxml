<?xml version="1.0" encoding="UTF-8"?>

<?import com.vortex.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vortex.controller.ConnectionTabController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <HBox alignment="CENTER" spacing="10.0">
        <TextField fx:id="ipField" promptText="IP Address" text="192.168.68.115" HBox.hgrow="ALWAYS" />
        <Button fx:id="connectButton" alignment="CENTER" onAction="#onConnectClicked" text="Connect" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
        <Button fx:id="disconnectButton" alignment="CENTER" disable="true" onAction="#onDisconnectClicked" text="Disconnect" textAlignment="CENTER" HBox.hgrow="ALWAYS" />
      <cursor>
         <Cursor fx:constant="DEFAULT" />
      </cursor>
    </HBox>

    <HexTextField fx:id="inputField" promptText="Command" />
    <Button maxWidth="1.7976931348623157E308" onAction="#onSendClicked" text="Send" />
</VBox>
