<?xml version="1.0" encoding="UTF-8"?>

<?import com.vortex.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="Infinity" prefHeight="480.0" prefWidth="854.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vortex.controller.SearchTabController">
    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>
    <HBox spacing="10.0">
        <ComboBox fx:id="searchTypeComboBox" maxWidth="Infinity" promptText="Search Type" HBox.hgrow="ALWAYS" />
        <HexTextField fx:id="startAddressField" maxWidth="Infinity" promptText="Start Address" HBox.hgrow="ALWAYS" />
        <HexTextField fx:id="endAddressField" maxWidth="Infinity" promptText="End Address" HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox spacing="10.0">
        <ComboBox fx:id="valueTypeComboBox" maxWidth="Infinity" promptText="Value Type" HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="comparisonComboBox" maxWidth="Infinity" promptText="Comparison" HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label fx:id="timeLabel" text="Time: 0.0s" />
        <Label fx:id="resultLabel" text="Results: 0" />
        <HexTextField fx:id="valueField" nodeOrientation="LEFT_TO_RIGHT" promptText="Value" HBox.hgrow="ALWAYS" />
    </HBox>
    <HBox maxHeight="Infinity" nodeOrientation="RIGHT_TO_LEFT" VBox.vgrow="ALWAYS">
        <TableView fx:id="searchResultsView" maxHeight="Infinity" HBox.hgrow="ALWAYS">
            <placeholder>
                <Label />
            </placeholder>
            <columns>
                <TableColumn fx:id="valueColumn" prefWidth="312.0" reorderable="false" resizable="false" text="Value" />
                <TableColumn fx:id="addressColumn" prefWidth="311.0" reorderable="false" resizable="false" text="Address" />
            </columns>
        </TableView>
        <VBox nodeOrientation="LEFT_TO_RIGHT" prefWidth="200.0">
            <ListView fx:id="selectedAddressesView" maxHeight="Infinity" VBox.vgrow="ALWAYS" />
            <HexTextField fx:id="valueWriteField" promptText="Value" />
         <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#onWriteValueClicked" text="Write" />
        </VBox>
    </HBox>
   <CheckBox fx:id="autoUpdateCheckBox" mnemonicParsing="false" text="Auto Update" />
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <ProgressBar fx:id="searchProgressBar" maxWidth="Infinity" progress="0.0" HBox.hgrow="ALWAYS" />
        <Label fx:id="searchProgressLabel" text="0.0%" />
    </HBox>
    <HBox spacing="10.0">
        <Button fx:id="searchButton" maxWidth="Infinity" onAction="#onSearchOrDumpClicked" text="Search" HBox.hgrow="ALWAYS" />
        <Button onAction="#onClearClicked" text="Clear" />
    </HBox>
</VBox>
